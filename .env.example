GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Smart routing. Groq is preferred for text, PDF text extraction, and Photo Solve when configured.
# Options: groq | gemini | deepseek | openai | claude
GENZ_AI_PROVIDER=

# Primary for development/testing: Gemini Free Tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional low-cost fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Optional premium providers.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase login + chat history.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy compatibility only if an older project still uses anon keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
