# Smart routing.
# Leave blank to auto-select the first configured provider, preferring DeepSeek.
# Options: deepseek | openai | claude
GENZ_AI_PROVIDER=

# Low-cost default: DeepSeek V4.1 Flash.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Optional premium providers.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase login + chat history.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy compatibility only if an older project still uses anon keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
